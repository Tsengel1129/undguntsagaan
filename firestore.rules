rules_version = '2';

// Public read (the site itself reads server-side via the Admin SDK, but
// public read keeps client-side reads possible); writes only for the
// hardcoded admin list — keep in sync with ADMIN_EMAILS in .env.local.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['srntyajr@gmail.com', 'me@ember.mn'];
    }
  }
}

rules_version = '2';

// Public read (download-token URLs), writes only for the hardcoded admin
// list — keep in sync with ADMIN_EMAILS in .env.local.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in ['srntyajr@gmail.com', 'me@ember.mn'];
    }
  }
}
